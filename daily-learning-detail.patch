   {request&&<TeacherDialog title="과목 재진단 요청" onClose={()=>setRequest(undefined)}><FeedbackComposer role="academic_manager" subject={requestSubject} target={request} onSubmit={async draft=>{await onFeedback(draft);setRequest(undefined);}} busy={busy}/></TeacherDialog>}
